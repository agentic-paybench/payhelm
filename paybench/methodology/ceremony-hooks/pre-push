#!/usr/bin/env bash
# pre-push freeze gate — refuses to push a `paybench-*prereg*` tag without committed
# freeze-evidence (CEREMONY-PREFLIGHT gates 8 + 9). Pass-through for everything else.
#
# Break-glass: PAYBENCH_FREEZE_OVERRIDE=1 git push ...   (warns, does not block)
#
# stdin lines: <local-ref> SP <local-oid> SP <remote-ref> SP <remote-oid>
set -u

root="$(git rev-parse --show-toplevel)"
guard="${root}/paybench/methodology/ceremony-hooks/freeze-guard.sh"
zero='0000000000000000000000000000000000000000'
rc=0

while read -r localref localoid _remoteref _remoteoid; do
  [ -n "${localref:-}" ] || continue
  case "$localref" in
    refs/tags/*prereg*) : ;;          # only guard pre-registration tags
    *) continue ;;
  esac
  [ "$localoid" = "$zero" ] && continue   # tag deletion — nothing to guard
  tag="${localref#refs/tags/}"
  if ! bash "$guard" "$tag" "$localoid"; then
    if [ "${PAYBENCH_FREEZE_OVERRIDE:-0}" = "1" ]; then
      echo "pre-push: PAYBENCH_FREEZE_OVERRIDE=1 set — pushing '$tag' despite missing evidence." >&2
    else
      echo "pre-push: refusing to push freeze tag '$tag'. Add the freeze-evidence file, or set" >&2
      echo "          PAYBENCH_FREEZE_OVERRIDE=1 to bypass (recorded in your shell history)." >&2
      rc=1
    fi
  fi
done

exit $rc
